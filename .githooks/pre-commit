#!/usr/bin/env bash
# A commit that changes the app bumps VERSION in the same commit (CLAUDE.md,
# Commits). Enabled by `make hooks`.
#
# SKIP_VERSION_CHECK=1 lets a commit through — for instance amending a commit
# that bumped it already: the check compares with HEAD, which an amend
# replaces.
set -euo pipefail

if [[ "${SKIP_VERSION_CHECK:-}" == 1 ]]; then exit 0; fi

# What this commit changes (both sides of a rename), paths unquoted.
staged="$(git -c core.quotePath=false diff --cached --name-only --no-renames -z | tr '\0' '\n')"
app="$(printf '%s\n' "$staged" | grep -E '^(Sources/|Resources/|Scripts/|Package\.swift$|Makefile$|mise\.toml$)' || true)"
if [[ -z "$app" ]]; then exit 0; fi
if printf '%s\n' "$staged" | grep -qx 'VERSION'; then exit 0; fi

{
  echo "pre-commit: this commit changes the app but not VERSION:"
  printf '%s\n' "$app" | sed -n '1,8s/^/    /p'
  if (($(printf '%s\n' "$app" | wc -l) > 8)); then echo "    …"; fi
  echo
  echo "Bump it in the same commit; the change's effect picks the part (CLAUDE.md, Commits):"
  echo "    Scripts/bump-version.sh patch|minor|major \"area: what changed\""
  echo "    git add VERSION CHANGELOG.md"
  echo "  major: incompatible (a saved-state format older versions can't read, a removed feature or shortcut)"
  echo "  minor: a new user-visible feature or capability"
  echo "  patch: a fix, performance work, polish, or an internal step of a larger feature"
  echo
  echo "Not a change to the app after all, or amending a commit that bumped it already:"
  echo "    SKIP_VERSION_CHECK=1 git commit …"
} >&2
exit 1
